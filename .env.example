# Leave CRM_DB_DRIVER=sqlite for local development.
CRM_DB_DRIVER=sqlite
CRM_SQLITE_PATH=crm.sqlite3

# For the shared SQL Server database, use these instead and keep the file private.
# CRM_DB_DRIVER=sqlserver
# DB_SERVER=your-server-host
# DB_PORT=1433
# DB_NAME=your-database
# DB_USER=your-user
# DB_PASSWORD=your-password
